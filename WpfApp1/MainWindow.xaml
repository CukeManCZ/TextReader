<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="TextReader" Height="800" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="Open" Command="{Binding LoadCommand}"/>
                <MenuItem Header="Save"/>
                <MenuItem Header="Open Link"/>
            </MenuItem>
            <MenuItem Header="Setting">
                <MenuItem Header="ChangeFont"/>
                <MenuItem Header="Theme"/>
                <MenuItem Header="ReadingMode"/>
            </MenuItem>
        </Menu>
        <ScrollViewer Name="svTextScroll" Grid.Row="1" Background="WhiteSmoke" SizeChanged="svTextScroll_SizeChanged">
            <TextBlock x:Name="tbCurrentText"
                Text="{Binding CurrentText, UpdateSourceTrigger=PropertyChanged}" 
                Margin="10 10 10 10" 
                FontSize="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
            />
        </ScrollViewer>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
            <!-- Pages status-->
            <TextBlock Width="100" TextAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} / {1}">
                        <Binding Path="CurrentPage"/>
                        <Binding Path="MaxPage"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
